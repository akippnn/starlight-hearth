
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg type="s" direction="out"/>
    </method>
  </interface>
  <interface name="org.freedesktop.DBus.Peer">
    <method name="Ping">
    </method>
    <method name="GetMachineId">
      <arg type="s" direction="out"/>
    </method>
  </interface>
  <interface name="org.freedesktop.DBus.Properties">
    <method name="Get">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg type="v" direction="out"/>
    </method>
    <method name="Set">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <method name="GetAll">
      <arg name="interface_name" type="s" direction="in"/>
      <arg type="a{sv}" direction="out"/>
    </method>
    <signal name="PropertiesChanged">
      <arg name="interface_name" type="s"/>
      <arg name="changed_properties" type="a{sv}"/>
      <arg name="invalidated_properties" type="as"/>
    </signal>
  </interface>
  <interface name="org.starlight.HearthShell.Input1">
    <method name="RegisterContext">
      <arg name="context" type="s" direction="in"/>
      <arg name="actions" type="as" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <method name="ClearContext">
      <arg name="context" type="s" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <signal name="Action">
      <arg name="action" type="s"/>
      <arg name="phase" type="s"/>
      <arg name="value" type="d"/>
      <arg name="monotonic_usec" type="t"/>
    </signal>
    <signal name="ReadinessChanged">
      <arg name="ready" type="b"/>
      <arg name="diagnostic" type="s"/>
    </signal>
    <property name="ActiveContext" type="s" access="read"/>
    <property name="Connected" type="b" access="read"/>
    <property name="GlyphFamily" type="s" access="read"/>
    <property name="Ready" type="b" access="read"/>
  </interface>
</node>
