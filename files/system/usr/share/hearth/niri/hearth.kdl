// HSN-001 global keyboard entrypoint and recovery. InputPlumber v4 owns
// controller semantics;
// Steam receives no desktop-mappable gamepad in this session.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// Quickshell requests a shaped blur through ext-background-effect. Keep this
// rule as the compositor-owned fallback when that protocol path is unavailable.
layer-rule {
    match namespace="^hearth-launcher-drawer$"
    background-effect {
        blur true
        xray true
    }
}

// niri-session normally activates the linked user units. Keep an explicit,
// idempotent compositor entrypoint as recovery for Gaming Mode transitions
// where the persistent user manager did not traverse niri.service.wants.
spawn-at-startup "systemctl" "--user" "start" "hearth-shell.service" "hearth-shell-ui.service"

binds {
    Super+A repeat=false hotkey-overlay-title="hearthOS Launcher" {
        spawn "busctl" "--user" "call" "org.starlight.HearthShell" "/Launcher" "org.starlight.HearthShell.Launcher1" "Toggle";
    }

    // Emergency keyboard paths remain available when hearthOS Shell is unhealthy.
    Ctrl+Alt+Return hotkey-overlay-title="Emergency Terminal" { spawn "konsole"; }
    Ctrl+Alt+D hotkey-overlay-title="Restart hearthOS Shell" {
        spawn "systemctl" "--user" "restart" "hearth-shell.service" "hearth-shell-ui.service";
    }
    Ctrl+Alt+Shift+E hotkey-overlay-title="Exit hearthOS Desktop" { quit; }
}
