#!/usr/bin/env bash
set -euo pipefail

ctl="${HEARTH_STEAMOSCTL:-/usr/bin/steamosctl}"
sessions_dir="${HEARTH_WAYLAND_SESSIONS_DIR:-/usr/share/wayland-sessions}"
input_request="${HEARTH_INPUT_REQUEST:-/usr/libexec/hearth-input-request}"

fail_contract() {
  echo "hearthOS session adapter: $*" >&2
  exit 2
}

request_input_mode() {
  local requested="$1"
  [[ -x "$input_request" ]] || fail_contract "input adapter is unavailable at $input_request"
  "$input_request" "$requested" || fail_contract "input adapter rejected $requested ownership"
}

run_ctl() {
  local fallback="$1"
  shift
  if ! "$ctl" "$@"; then
    "$input_request" "$fallback" >/dev/null 2>&1 || true
    fail_contract "steamosctl failed: $*"
  fi
}

require_commands() {
  [[ -x "$ctl" ]] || fail_contract "steamosctl is unavailable at $ctl"

  local help
  if ! help="$($ctl --help 2>&1)"; then
    fail_contract "steamosctl help failed; refusing to alter session state"
  fi

  local command
  for command in "$@"; do
    grep -Fq "$command" <<<"$help" || \
      fail_contract "unsupported steamosctl contract (missing $command)"
  done
}

require_session() {
  local session="$1"
  [[ -r "$sessions_dir/$session" ]] || \
    fail_contract "session file is unavailable: $session"

  local valid
  if ! valid="$($ctl get-valid-desktop-sessions 2>&1)"; then
    fail_contract "cannot query valid desktop sessions"
  fi
  grep -Eq "(^|[[:space:]])${session//./\\.}($|[[:space:]])" <<<"$valid" || \
    fail_contract "steamos-manager does not advertise $session"
}

restore_hearth_desktop_if_available() {
  local session="hearth.desktop"
  if [[ ! -r "$sessions_dir/$session" ]]; then
    echo "hearthOS session adapter: warning: cannot restore missing $session; continuing to Gaming Mode" >&2
    return 0
  fi

  local valid
  if ! valid="$($ctl get-valid-desktop-sessions 2>&1)"; then
    echo "hearthOS session adapter: warning: cannot query Desktop sessions; continuing to Gaming Mode" >&2
    return 0
  fi
  if ! grep -Eq "(^|[[:space:]])${session//./\\.}($|[[:space:]])" <<<"$valid"; then
    echo "hearthOS session adapter: warning: $session is not advertised; continuing to Gaming Mode" >&2
    return 0
  fi
  if ! "$ctl" set-default-desktop-session "$session"; then
    echo "hearthOS session adapter: warning: could not restore $session; continuing to Gaming Mode" >&2
  fi
}

mode="${1:-}"
case "$mode" in
  desktop)
    require_commands get-valid-desktop-sessions set-default-desktop-session switch-to-desktop-mode
    require_session hearth.desktop
    request_input_mode desktop
    run_ctl safe set-default-desktop-session hearth.desktop
    run_ctl safe switch-to-desktop-mode
    ;;
  gaming)
    require_commands get-valid-desktop-sessions set-default-desktop-session set-default-login-mode switch-to-game-mode
    request_input_mode gaming
    restore_hearth_desktop_if_available
    run_ctl safe set-default-login-mode game
    run_ctl safe switch-to-game-mode
    ;;
  recovery-kde)
    require_commands get-valid-desktop-sessions set-default-desktop-session switch-to-desktop-mode
    require_session plasma.desktop
    request_input_mode safe
    run_ctl safe set-default-desktop-session plasma.desktop
    run_ctl safe switch-to-desktop-mode
    ;;
  set-default-desktop)
    require_commands get-valid-desktop-sessions set-default-desktop-session
    require_session hearth.desktop
    "$ctl" set-default-desktop-session hearth.desktop
    ;;
  *)
    echo "usage: hearth-session-mode {desktop|gaming|recovery-kde|set-default-desktop}" >&2
    exit 2
    ;;
esac
